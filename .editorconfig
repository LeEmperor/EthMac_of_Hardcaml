root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{ml,mli}]
indent_size = 2
max_line_length = 90

[{dune,dune-project}]
indent_size = 1

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
