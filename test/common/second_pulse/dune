; University of Florida
; Author: Bohdan Purtell
;
; Dune specs for the 1 Hz heartbeat pulse verif suite

(library
 (name second_pulse_inline_tests)
 (modules
  second_pulse_testbench
  second_pulse_unit_quickcheck_tests
  second_pulse_expect_tests)
 ; The trailing -source-tree-root wins over the one dune passes (%{workspace_root},
 ; ../../.. from here). Works around a ppx_expect v0.18~preview bug: it drops the
 ; directory from the test file's path when registering a test, then rebuilds the path
 ; at exit from the bare filename plus -source-tree-root, yielding
 ; _build/default/<basename>, which does not exist. "." points it at the runner's cwd,
 ; where dune copies the sources. Drop this if a later ppx_expect fixes the path handling.
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (libraries
  core
  hardcaml
  helper_circuits
  hardcaml_waveterm
  hardcaml_step_testbench
  hardcaml_verif)
 (preprocess
  (pps ppx_hardcaml ppx_jane))
 (lint
  (pps ppx_js_style))
 (flags
  (:standard -w -27-57-33-34-35-40-63-47-26)))

; The legacy harness is a bare (executable): built by [dune build] so it keeps
; type-checking against the RTL, never invoked by [dune runtest].

(executable
 (name second_pulse_legacy_assertion_test)
 (modules second_pulse_legacy_assertion_test)
 (libraries core hardcaml helper_circuits hardcaml_waveterm)
 (preprocess
  (pps ppx_hardcaml ppx_jane))
 (lint
  (pps ppx_js_style))
 (flags
  (:standard -w -27-57-33-34-35-40-63-47-26)))
